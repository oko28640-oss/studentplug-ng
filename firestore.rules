rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'oko28640@gmail.com' ||
        request.auth.token.email == 'admin@studentplug.ng' ||
        request.auth.uid == 'admin_user_studentplug' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Connection validation
    match /test/{docId} {
      allow read: if true;
    }

    // 1. Users Collection
    match /users/{userId} {
      // Public student marketplace profiles can be viewed by all campus buyers and sellers
      allow read: if true;
      // Users can only create or update their own profile; Admins can update roles/suspension
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Institutions Directory & Campuses
    match /institutions/{institutionId} {
      // Anyone can read tertiary institutions
      allow read: if true;
      // Authenticated users or admins can create/seed institutions
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 3. Listings (Products & Student Services)
    match /listings/{listingId} {
      // Anyone can browse active listings
      allow read: if true;
      // Authenticated students can post listings where they are the seller, or admin
      allow create: if isSignedIn() && (request.resource.data.sellerId == request.auth.uid || isAdmin());
      // Only the seller or admin can edit, pause, mark sold, or delete
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // 4. Orders
    match /orders/{orderId} {
      // Only the buyer, seller, or admin can read the order
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      // Authenticated buyer can create an order, or admin
      allow create: if isSignedIn() && (request.resource.data.buyerId == request.auth.uid || isAdmin());
      // Buyer, seller, or admin can update order status
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 5. Conversations & Real-Time Messages
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.senderId == request.auth.uid
        );
        allow update: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow delete: if isAdmin();
      }
    }

    // 6. Reviews & Ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
    }

    // 7. Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 8. Flagged Reports & Moderation
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 9. Student ID Verification Submissions
    match /verificationRequests/{requestId} {
      // Sensitive: Only student who submitted or admin can read
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 10. Promotions & Featured Bumps
    match /promotions/{promotionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
